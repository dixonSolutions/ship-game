# Copy to .env and fill in locally. Never commit .env.

# AWS — server-side only. Never expose to the browser.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=256
BEDROCK_RATE_LIMIT_PER_MINUTE=20

# Polly
POLLY_VOICE_ID=Matthew
POLLY_ENGINE=neural
POLLY_RATE_LIMIT_PER_MINUTE=30

# Server
PORT=8787
CORS_ORIGIN=http://localhost:4200
NODE_ENV=development
# Keep true for local UI without AWS credentials. Set false only on a secured server.
MOCK_AWS=true
