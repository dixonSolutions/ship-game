{
  "name": "client",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "node ../scripts/run-client.mjs",
    "prebuild": "node ../scripts/sync-client-env.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck": "ng build --configuration development --verbose=false",
    "lint": "ng build --configuration development"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/cdk": "^21.1.0",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@openng/optimus-ui": "1.0.0-rc.1",
    "@openng/optimus-ui-themes": "1.0.0-rc.1",
    "howler": "^2.2.4",
    "rxjs": "~7.8.0",
    "three": "^0.178.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@types/howler": "^2.2.12",
    "@types/three": "^0.178.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
